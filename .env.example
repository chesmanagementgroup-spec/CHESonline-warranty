# ---------------------------------------------------------------------------
# CHES Online Warranty Platform — environment configuration
# Copy to .env and fill in.  Never commit .env.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
PORT=3000
NODE_ENV=production
# Public base URL of the platform (used in email links).  No trailing slash.
APP_BASE_URL=https://warranty.chesonline.com.au
# Random secret used to sign/derive session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Where data lives -------------------------------------------------------
DATA_DIR=./data

# --- CHES internal mailboxes ------------------------------------------------
# Every new service request lands here (the "system email").
# Comma-separated: the whole after-sales team gets it, not one inbox.
CHES_SERVICE_EMAIL=RitaW@CHESonline.com.au, Service@CHESonline.com.au
# The address customers are given when equipment is out of warranty and they
# want help arranging a repairer.
CHES_AFTERSALES_EMAIL=Service@CHESonline.com.au
# Shown to customers as the reply-to / contact address.
CHES_FROM_NAME=CHES Online
CHES_FROM_EMAIL=chesmanagementgroup@gmail.com

# --- SMTP (leave blank to run in dev mode: emails written to data/outbox) ----
# Gmail: host smtp.gmail.com, port 465, secure true, user = the mailbox,
# pass = a Google App Password (NOT the account password).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# --- Staff accounts ---------------------------------------------------------
# The first account is created on first boot if no staff exist. Add the rest
# with:  npm run seed -- --email name@chesonline.com.au --password '...' --name 'Name'
ADMIN_NAME=Rita
ADMIN_EMAIL=RitaW@CHESonline.com.au
ADMIN_PASSWORD=

# A second staff login, created on the same run.
STAFF2_NAME=Cristina
STAFF2_EMAIL=Service@CHESonline.com.au
STAFF2_PASSWORD=

# --- Defaults ---------------------------------------------------------------
DEFAULT_WARRANTY_MONTHS=12
LOGIN_CODE_TTL_MINUTES=15
SESSION_TTL_DAYS=30
